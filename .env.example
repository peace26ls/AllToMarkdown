# OpenAI / 兼容接口配置（Phase 2 整理层使用）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 低置信度阈值：confidence 低于此值的 block 标 needs_review 进复核清单
CONFIDENCE_THRESHOLD=0.7

# 扫描件预检：每页文字密度低于该阈值（字符/页）判定为扫描件
PDF_TEXT_DENSITY_THRESHOLD=80

# Phase 4 —— 扫描件 OCR（需 pip install paddlepaddle paddleocr）
# 扫描件渲染分辨率：越高越准越慢
OCR_DPI=150

# Phase 4 —— 多模态「高质量模式」
# 单次任务最多处理的页数（按页计费！留空表示不限）
VISION_MAX_PAGES=
